<!--
  Synthetic ISO 20022 auth.106 EMIR Derivatives Trade Warnings Report
  fixture. Hand-authored — NOT derived from, and does not redistribute,
  any ESMA or SWIFT example or schema.

  Element paths follow the real ESMA EMIR REFIT usage guideline
  auth.106.001.01_ESMAUG_DATWRN_1.1.0
  (DerivativesTradeWarningsReportV01):
  Document > DerivsTradWrnngsRpt > WrnngsSttstcs/Rpt
  (one per reference date). Schema-shaped, not a fully XSD-valid
  instance. See docs/auth-messages/emir-auth106.md.

  OpenDQI models THREE levels, kept strictly separate: the
  REPORT-LEVEL aggregate (one TradeWarningsRecord per RefDt, no LEI),
  the PER-COUNTERPARTY aggregate (one WarningsCounterpartyRecord per
  RefDt+LEI, merging the three Wrnngs blocks for that LEI), and the
  PER-UTI level (one WarningsTransactionRecord per Wrnngs/TxDtls). The
  per-counterparty and per-UTI values MUST NOT leak into the
  report-level aggregate — the huge Wrnngs values below prove the
  layers stay separate.

  Each Wrnngs block carries one TxDtls (UTIWRNVAL.../UTIWRNMRG...
  /UTIWRNABN...) -> one issue each: EMIR.WRN.TX_MISSING_VALUATION,
  EMIR.WRN.TX_MISSING_MARGIN, EMIR.WRN.TX_ABNORMAL_VALUE. The amount
  leaves carry a Ccy attribute (ValtnAmt USD, NtnlAmt EUR); the
  per-UTI raw_fields preserves it as "value|Ccy=XXX".

  Report-level derived rates (defaults: valuation/margin max 0.05,
  abnormal 0.01):
    missing_valuation  80/1000 = 0.08  > 0.05 -> MISSING_VALUATION_HIGH
    outdated_valuation 20/1000 = 0.02  < 0.05 -> (clean)
    missing_margin     40/500  = 0.08  > 0.05 -> MISSING_MARGIN_INFO_HIGH
    outdated_margin     5/500  = 0.01  < 0.05 -> (clean)
    abnormal_values    60/2000 = 0.03  > 0.01 -> ABNORMAL_VALUES_HIGH

  Per-counterparty LEIA0000000000000001 (merged across the 3 Wrnngs
  blocks): valuation 999999/999999, missing margin 888888/888888,
  abnormal 777777/777777 = rate 1.0 -> the four CTRPTY_* checks with
  a numerator+denominator fire (outdated-margin has no per-CP
  numerator here -> clean).
-->
<Document xmlns="urn:iso:std:iso:20022:tech:xsd:auth.106.001.01">
  <DerivsTradWrnngsRpt>
    <WrnngsSttstcs>
      <Rpt>
        <RefDt>2026-05-13</RefDt>
        <MssngValtn><Rpt>
          <NbOfOutsdngDerivs>1000</NbOfOutsdngDerivs>
          <NbOfOutsdngDerivsWthNoValtn>80</NbOfOutsdngDerivsWthNoValtn>
          <NbOfOutsdngDerivsWthOutdtdValtn>20</NbOfOutsdngDerivsWthOutdtdValtn>
          <Wrnngs>
            <CtrPtyId><RptgCtrPty><LEI>LEIA0000000000000001</LEI></RptgCtrPty></CtrPtyId>
            <NbOfOutsdngDerivs>999999</NbOfOutsdngDerivs>
            <NbOfOutsdngDerivsWthNoValtn>999999</NbOfOutsdngDerivsWthNoValtn>
            <NbOfOutsdngDerivsWthOutdtdValtn>999999</NbOfOutsdngDerivsWthOutdtdValtn>
            <TxDtls>
              <TxId>
                <OthrCtrPty><Lgl><LEI>OTHRB000000000000002</LEI></Lgl></OthrCtrPty>
                <UnqIdr><UnqTxIdr>UTIWRNVAL00000000001</UnqTxIdr></UnqIdr>
              </TxId>
              <ValtnAmt><Amt><Amt Ccy="USD">123456.78</Amt></Amt></ValtnAmt>
              <ValtnTmStmp>2026-05-12T09:00:00Z</ValtnTmStmp>
            </TxDtls>
          </Wrnngs>
        </Rpt></MssngValtn>
        <MssngMrgnInf><Rpt>
          <NbOfOutsdngDerivs>500</NbOfOutsdngDerivs>
          <NbOfOutsdngDerivsWthNoMrgnInf>40</NbOfOutsdngDerivsWthNoMrgnInf>
          <NbOfOutsdngDerivsWthOutdtdMrgnInf>5</NbOfOutsdngDerivsWthOutdtdMrgnInf>
          <Wrnngs>
            <CtrPtyId><RptgCtrPty><LEI>LEIA0000000000000001</LEI></RptgCtrPty></CtrPtyId>
            <NbOfOutsdngDerivs>888888</NbOfOutsdngDerivs>
            <NbOfOutsdngDerivsWthNoMrgnInf>888888</NbOfOutsdngDerivsWthNoMrgnInf>
            <TxDtls>
              <TxId>
                <UnqIdr><UnqTxIdr>UTIWRNMRG00000000002</UnqTxIdr></UnqIdr>
              </TxId>
              <CollTmStmp>2026-05-13T00:00:00Z</CollTmStmp>
            </TxDtls>
          </Wrnngs>
        </Rpt></MssngMrgnInf>
        <AbnrmlVals><Rpt>
          <NbOfDerivsRptd>2000</NbOfDerivsRptd>
          <NbOfDerivsRptdWthOtlrs>60</NbOfDerivsRptdWthOtlrs>
          <Wrnngs>
            <CtrPtyId><RptgCtrPty><LEI>LEIA0000000000000001</LEI></RptgCtrPty></CtrPtyId>
            <NbOfDerivsRptd>777777</NbOfDerivsRptd>
            <NbOfDerivsRptdWthOtlrs>777777</NbOfDerivsRptdWthOtlrs>
            <TxDtls>
              <TxId>
                <ActnTp>NEWT</ActnTp>
                <UnqIdr><UnqTxIdr>UTIWRNABN00000000003</UnqTxIdr></UnqIdr>
              </TxId>
              <NtnlAmt><FrstLeg><Amt><Amt Ccy="EUR">999000000.00</Amt></Amt></FrstLeg></NtnlAmt>
            </TxDtls>
          </Wrnngs>
        </Rpt></AbnrmlVals>
      </Rpt>
    </WrnngsSttstcs>
  </DerivsTradWrnngsRpt>
</Document>
