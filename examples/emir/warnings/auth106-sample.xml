    outdated_valuation 20/1000 = 0.02  < 0.05 -> (clean)
    missing_margin     40/500  = 0.08  > 0.05 -> MISSING_MARGIN_INFO_HIGH
    outdated_margin     5/500  = 0.01  < 0.05 -> (clean)
    abnormal_values    60/2000 = 0.03  > 0.01 -> ABNORMAL_VALUES_HIGH
-->
