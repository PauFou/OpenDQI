    </Sts>
    <Sts>
      <RcncltnBrk>
        <UnqTxIdr>OPENDQI-T2-NOTVALCCY-0002</UnqTxIdr>
        <RsnDesc>Counterparty reports a different notional value.</RsnDesc>
      </RcncltnBrk>
    </Sts>
  </FeedbackToReportingMembers>
</Document>
