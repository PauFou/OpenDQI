      <RptgPty><LEI>12345678901234567890</LEI></RptgPty>
      <RcncltnDtTm>2026-05-13T08:00:00Z</RcncltnDtTm>
    </Hdr>
    <Rcncltn>
      <UnqTxIdr>OPENDQI-T2-CLEAN-0001</UnqTxIdr>
      <RptgCtrPty><LEI>12345678901234567890</LEI></RptgCtrPty>
      <OthrCtrPty><LEI>09876543210987654321</LEI></OthrCtrPty>
      <PrngSts>PAIRED</PrngSts>
      <RcncltnSts>RECONCILED</RcncltnSts>
    </Rcncltn>
    <Rcncltn>
      <UnqTxIdr>OPENDQI-T2-SELFDEAL-0005</UnqTxIdr>
