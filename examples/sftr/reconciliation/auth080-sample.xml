              </CollMtchgCrit>
            </MtchgCrit>
          </NotMtchd></RptgData></RcncltnSts>
        </RcncltnRpt>

        <!-- 3. No reconciliation required -> no status assertion. -->
        <RcncltnRpt>
          <TxId><UnqTradIdr>OPENDQI-SFTR-RECON-NOREQ-3</UnqTradIdr></TxId>
          <Modfd>false</Modfd>
          <RcncltnSts><NoRcncltnReqrd>NORE</NoRcncltnReqrd></RcncltnSts>
        </RcncltnRpt>

      </Rpt>
    </RcncltnData>
  </SctiesFincgRptgRcncltnStsAdvc>
</Document>
