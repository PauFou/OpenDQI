      <CollVal Ccy="EUR">800000</CollVal>
      <Hrcut>0.05</Hrcut>
      <MtrtyDt>2024-12-31</MtrtyDt>
    </SftStat>

    <!-- 4. HAIRCUT_OUT_OF_RANGE: 1.5 is &gt; 1.0. -->
    <SftStat>
      <UnqTxIdr>OPENDQI-SFTR-TSR-HRCUT-0004</UnqTxIdr>
      <RptgCtrPty><LEI>ABCDEFGHIJKLMNOPQR01</LEI></RptgCtrPty>
      <OthrCtrPty><LEI>ABCDEFGHIJKLMNOPQR02</LEI></OthrCtrPty>
      <Sts>OUTSTANDING</Sts>
      <SftTp>REPO</SftTp>
      <LoanAmt Ccy="USD">2000000</LoanAmt>
      <CollVal Ccy="USD">2100000</CollVal>
      <Hrcut>1.5</Hrcut>
      <MtrtyDt>2027-02-15</MtrtyDt>
    </SftStat>

