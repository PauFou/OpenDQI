    <!-- 6. STALE_VALUATION: state_as_of is recent, but record-level
         valuation_timestamp absent and CollVal is present with a far
         maturity — covered by stale_valuation when state_as_of > threshold.
         Here we add a TERMINATED SFT to ensure outstanding filter is sane. -->
    <SftStat>
      <UnqTxIdr>OPENDQI-SFTR-TSR-TERM-0006</UnqTxIdr>
      <RptgCtrPty><LEI>ABCDEFGHIJKLMNOPQR01</LEI></RptgCtrPty>
      <OthrCtrPty><LEI>ABCDEFGHIJKLMNOPQR02</LEI></OthrCtrPty>
      <Sts>TERMINATED</Sts>
      <SftTp>REPO</SftTp>
      <LoanAmt Ccy="EUR">100000</LoanAmt>
      <CollVal Ccy="EUR">102000</CollVal>
      <Hrcut>0.05</Hrcut>
      <MtrtyDt>2027-01-01</MtrtyDt>
      <TermntnDt>2026-04-30</TermntnDt>
    </SftStat>

