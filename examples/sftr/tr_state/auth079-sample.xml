      <UnqTxIdr>OPENDQI-SFTR-TSR-NOCOLL-0002</UnqTxIdr>
      <RptgCtrPty><LEI>ABCDEFGHIJKLMNOPQR01</LEI></RptgCtrPty>
      <OthrCtrPty><LEI>ABCDEFGHIJKLMNOPQR02</LEI></OthrCtrPty>
      <Sts>OUTSTANDING</Sts>
      <SftTp>REPO</SftTp>
      <LoanAmt Ccy="EUR">500000</LoanAmt>
      <MtrtyDt>2026-09-30</MtrtyDt>
    </SftStat>

    <!-- 3. ACTIVE_PAST_MATURITY: outstanding but maturity is in the past. -->
    <SftStat>
      <UnqTxIdr>OPENDQI-SFTR-TSR-PASTMAT-0003</UnqTxIdr>
      <RptgCtrPty><LEI>ABCDEFGHIJKLMNOPQR01</LEI></RptgCtrPty>
      <OthrCtrPty><LEI>ABCDEFGHIJKLMNOPQR02</LEI></OthrCtrPty>
      <Sts>OUTSTANDING</Sts>
      <SftTp>BSB</SftTp>
