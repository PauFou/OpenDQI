    <SftStat>
      <UnqTxIdr>OPENDQI-SFTR-TSR-DUP-0005</UnqTxIdr>
      <RptgCtrPty><LEI>ABCDEFGHIJKLMNOPQR01</LEI></RptgCtrPty>
      <OthrCtrPty><LEI>ABCDEFGHIJKLMNOPQR02</LEI></OthrCtrPty>
      <Sts>OUTSTANDING</Sts>
      <SftTp>SLEB</SftTp>
      <LoanAmt Ccy="EUR">300000</LoanAmt>
