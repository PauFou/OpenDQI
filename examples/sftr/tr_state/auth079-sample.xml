<!--
  Synthetic SFTR Trade State Report (auth.079.001.01) for OpenDQI tests.
  Hand-authored — not derived from any ESMA or SWIFT example.
  Each SftStat exercises one of the 6 SFTR.TST.* checks, plus a clean
  outstanding baseline so SFTR.TST.OUTSTANDING_SUMMARY emits a row.
-->
<Document xmlns="urn:iso:std:iso:20022:tech:xsd:auth.079.001.01">
  <SftStateReport>
    <Hdr><StateAsOf>2026-05-13T08:00:00Z</StateAsOf></Hdr>

    <!-- 1. CLEAN outstanding REPO with valid haircut (baseline). -->
    <SftStat>
      <UnqTxIdr>OPENDQI-SFTR-TSR-CLEAN-0001</UnqTxIdr>
      <RptgCtrPty><LEI>ABCDEFGHIJKLMNOPQR01</LEI></RptgCtrPty>
      <OthrCtrPty><LEI>ABCDEFGHIJKLMNOPQR02</LEI></OthrCtrPty>
      <Sts>OUTSTANDING</Sts>
      <SftTp>REPO</SftTp>
      <LoanAmt Ccy="EUR">1000000</LoanAmt>
      <CollVal Ccy="EUR">1050000</CollVal>
      <Hrcut>0.05</Hrcut>
      <RuseInd>false</RuseInd>
      <EvntDt>2026-05-12</EvntDt>
      <MtrtyDt>2026-08-12</MtrtyDt>
      <SttlmDt>2026-05-13</SttlmDt>
      <Sctys><ISIN>DE0001135275</ISIN></Sctys>
    </SftStat>

    <!-- 2. MISSING_COLLATERAL: outstanding but CollVal absent. -->
