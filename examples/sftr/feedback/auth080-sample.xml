    </Hdr>
    <Sts>
      <Rjctd>
        <UnqTxIdr>OPENDQI-SFTR-T2-CLEAN-0001</UnqTxIdr>
        <RsnCd>VAL07</RsnCd>
        <RsnDesc>Loan currency missing.</RsnDesc>
      </Rjctd>
    </Sts>
    <Sts>
      <Mssng>
        <UnqTxIdr>OPENDQI-SFTR-T2-CLEAN-0001</UnqTxIdr>
      </Mssng>
    </Sts>
    <Sts>
      <Mssng>
        <UnqTxIdr>OPENDQI-SFTR-NEVER-SUBMITTED-9999</UnqTxIdr>
