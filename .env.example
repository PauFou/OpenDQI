# OpenDQI environment-variable template.
# Copy to .env and fill in real values. .env is git-ignored.

# SMTP password for the `--email-config` flag on `opendqi {emir,sftr}
# scan`. Replace with an app-specific password (Gmail, SendGrid, etc.)
# and never commit the populated .env file. The env var name is
# configurable via `password_env` in your SMTP YAML; OPENDQI_SMTP_PASS
# is the default.
OPENDQI_SMTP_PASS=replace-with-app-specific-password
